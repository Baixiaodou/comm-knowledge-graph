# 复制此文件为 .env 并填入真实 key（.env 已被 .gitignore 排除，不会提交）
# 用途：跑评测 benchmark 需要调用大模型

# DeepSeek（答题/精挑模型）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# 硅基流动 SiliconFlow（Qwen/GLM 等开源模型）
SILICONFLOW_API_KEY=sk-your-siliconflow-key-here

# 阿里云百炼 DashScope（裁判模型 qwen-max，可选）
DASHSCOPE_API_KEY=sk-your-dashscope-key-here
